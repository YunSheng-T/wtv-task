{
  "name": "@wtv-task/app",
  "version": "0.1.0",
  "private": true,
  "main": "./dist/main/index.cjs",
  "scripts": {
    "build": "electron-vite build",
    "dev": "electron-rebuild -f -w better-sqlite3 && electron-vite dev",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "rebuild": "electron-rebuild -f -w better-sqlite3",
    "rebuild:electron": "electron-rebuild -f -w better-sqlite3",
    "rebuild:node": "npm rebuild better-sqlite3",
    "start": "electron-rebuild -f -w better-sqlite3 && electron dist/main/index.cjs"
  },
  "dependencies": {
    "@fastify/websocket": "^11.0.0",
    "@mantine/core": "^7.15.0",
    "@mantine/hooks": "^7.15.0",
    "@mantine/notifications": "^7.15.0",
    "@tabler/icons-react": "^3.26.0",
    "@tanstack/react-query": "^5.62.0",
    "@wtv-task/core": "workspace:*",
    "@wtv-task/server": "workspace:*",
    "better-sqlite3": "^11.7.0",
    "drizzle-orm": "^0.38.0",
    "electron-router-dom": "^1.0.5",
    "fastify": "^5.2.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zod": "^3.24.0",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@electron/rebuild": "^3.7.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^33.2.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^2.3.0",
    "vite": "^5.4.0"
  }
}